<!DOCTYPE html>
<html lang="en">

<head>
    <script src="js/app.js"></script>

    <style>
        html,
        body {
            margin: 0;
            padding: 0;
            height: 100%;
        }

        .swiper {
            width: 100%;
            height: 75%;
        }

        .swiper-slide {
            text-align: center;
            font-size: 18px;
            display: flex;
            justify-content: center;
            align-items: center;

        }

        .swiper-slide>img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .tours-slide {
            height: 550px;
            padding: 1rem;
            min-width: 500px;
            width: 550px;
        }

        .card {
            width: 550px;
            height: 500px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1), 0 6px 10px rgba(0, 0, 0, 0.2);
        }

        #sliderTours {
            max-height: 650px;
        }

        .card-img-top {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .swiper-button-prev:hover {
            color: #57ACE0;
            transform: translateX(-10px);
        }

        .swiper-button-next:hover {
            color: #57ACE0;
            transform: translateX(10px);
        }
    </style>
</head>

<body>
    <!-- Page content -->
    <div class="container-fill">
        <div class="swiper">
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <img src="images/swiper-hoi-an-pic.jpg" />
                </div>
                <div class="swiper-slide">
                    <img src="images/swiper-cao-bang-pic.jpg" />
                </div>
                <div class="swiper-slide">
                    <img src="images/swiper-sai-gon-pic.jpg" />
                </div>
                <div class="swiper-slide">
                    <img src="images/swiper-sydney-pic.jpg" />
                </div>
                <div class="swiper-slide">
                    <img src="images/swiper-thailand-pic.jpg" />
                </div>
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-pagination"></div>
        </div>
        <div class="row p-3 mt-2 tour-types d-flex justify-content-center" data-aos="fade-right">
            <div class="col-lg-4 d-flex justify-content-center align-items-center tour-type m-2 p-4">

                <a class="tours-heading-link" href="vietnamTours.html"><i class="fa-solid fa-glasses fa-xl mx-2"></i>DU
                    LỊCH
                    TRONG NƯỚC</a>
            </div>
            <div class="col-lg-4 d-flex justify-content-center align-items-center tour-type m-2 p-4">

                <a class="tours-heading-link" href="foreignTours.html"><i
                        class="fa-solid fa-wine-glass fa-xl mx-2"></i>DU LỊCH
                    NƯỚC NGOÀI</a>
            </div>
            <div class="col-lg-4 d-flex justify-content-center align-items-center tour-type m-2 p-4">

                <a class="tours-heading-link" href="introduction.html"><i class="fa-solid fa-home fa-xl mx-2"></i>GIỚI
                    THIỆU</a>
            </div>
            <div class="col-lg-4 d-flex justify-content-center align-items-center tour-type m-2 p-4">
                <a class="tours-heading-link" href="hotels.html"><i class="fa-solid fa fa-hotel fa-xl mx-2"></i>CHO THUÊ
                    KHÁCH
                    SẠN</a>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mx-5 mt-5 mb-3">
            <a class="tours-heading-link" style="text-decoration: none;">CÁC TOUR TRONG NƯỚC GẦN ĐÂY</a>
            <a class="tours-heading-link" href="#" style="text-decoration: none;"><i
                    class="fa-solid fa-list mx-2"></i>Xem tất cả</a>
        </div>
        <div class="px-5 mb-5" data-aos="fade-right">
            <div class="vietnam-tours-swiper">
                <div class="swiper-wrapper" id="sliderTours">
                    {{#each naTours}}
                    <div class="swiper-slide tours-slide">
                        <div class="card" style="width: 100%">
                            <div class="hovereffect">
                                <img class="card-img-top" src="{{this.tour_img}}" alt="">
                                <div class="overlay">
                                    <h2>{{this.departure}}</h2>
                                </div>
                            </div>
                            <div class="card-body">
                                <!-- Tour information -->
                                <div class="d-flex flex-column justify-content-start">
                                    <a class="text-start mb-3 tour-title" style="text-decoration: none;"
                                        href="/tours/{{this.tour_id}}">{{this.tour_name}}</a>
                                    <div class="d-flex align-items-center">
                                        <i class="fa-regular fa-clock mx-2"></i>
                                        <a style="font-size: 0.85rem">{{this.duration}}</a>
                                    </div>
                                    <div class="d-flex align-items-center mt-1">
                                        <i class="fa-regular fa-calendar mx-2"></i>
                                        <a style="font-size: 0.85rem">{{this.dep_date}}</a>
                                    </div>
                                    <div class="d-flex align-items-center mt-1">
                                        <i class="fa-regular fa-user mx-2"></i>
                                        <a style="font-size: 0.85rem">{{this.slot}}</a>
                                    </div>
                                    <div class="d-flex align-items-center mt-1">
                                        <i class="fa-solid fa-sack-dollar mx-2"></i>
                                        <a class="text-decoration-none" style="color: red; font-weight: bold;"
                                            id="tourPrice">{{formatPrice this.price}}</a>
                                    </div>
                                </div>
                                <!-- Tour information -->
                            </div>
                        </div>
                    </div>
                    {{/each}}

                </div>
                <div class="swiper-button-next" style="z-index: 9999;"></div>
                <div class="swiper-button-prev" style="z-index: 9999;"></div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mx-5 mt-5 mb-3">
            <a class="tours-heading-link" style="text-decoration: none;">CÁC TOUR NƯỚC NGOÀI GẦN ĐÂY</a>
            <a class="tours-heading-link" href="#" style="text-decoration: none;"><i
                    class="fa-solid fa-list mx-2"></i>Xem tất cả</a>
        </div>


        <div class="px-5 mb-5" data-aos="fade-right">
            <div class="foreign-tours-swiper">
                <div class="swiper-wrapper" id="sliderTours">
                    {{#each interTours}}
                    <div class="swiper-slide tours-slide">
                        <div class="card" style="width: 100%">
                            <div class="hovereffect">
                                <img class="card-img-top" src="{{this.tour_img}}" alt="">
                                <div class="overlay">
                                    <h2>{{this.departure}}</h2>
                                </div>
                            </div>
                            <div class="card-body">
                                <!-- Tour information -->
                                <div class="d-flex flex-column justify-content-start">
                                    <a class="text-start mb-3 tour-title" style="text-decoration: none;"
                                        href="/tours/{{this.tour_id}}">{{this.tour_name}}</a>
                                    <div class="d-flex align-items-center">
                                        <i class="fa-regular fa-clock mx-2"></i>
                                        <a style="font-size: 0.85rem">{{this.duration}}</a>
                                    </div>
                                    <div class="d-flex align-items-center mt-1">
                                        <i class="fa-regular fa-calendar mx-2"></i>
                                        <a style="font-size: 0.85rem">{{this.dep_date}}</a>
                                    </div>
                                    <div class="d-flex align-items-center mt-1">
                                        <i class="fa-regular fa-user mx-2"></i>
                                        <a style="font-size: 0.85rem">{{this.slot}}</a>
                                    </div>
                                    <div class="d-flex align-items-center mt-1">
                                        <i class="fa-solid fa-sack-dollar mx-2"></i>
                                        <a class="text-decoration-none" style="color: red; font-weight: bold;"
                                            id="tourPrice">{{formatPrice this.price}}</a>
                                    </div>
                                </div>
                                <!-- Tour information -->
                            </div>
                        </div>
                    </div>
                    {{/each}}

                </div>
                <div class="swiper-button-next" style="z-index: 9999;"></div>
                <div class="swiper-button-prev" style="z-index: 9999;"></div>
            </div>
        </div>

        <div class="px-5 mb-5">
            <div class="m-5 text-center">
                <span class="h3">Đánh giá của người dùng</span>
            </div>
            <div class="d-flex justify-content-center mb-3">
                <div class="commentBox">
                    <div class="p-3 row border" id="contactFormContainer">
                        <div class="col-12 aos-init aos-animate" data-aos="fade-right">
                            <form>
                                <h3 class="mb-3">Gửi đánh giá</h3>
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="floatingFullnameInput"
                                        placeholder="name@example.com">
                                    <label for="floatingFullnameInput" style="font-size: 0.75rem;">Họ và tên</label>
                                </div>
                                <div class="form-floating mb-3">
                                    <input type="email" class="form-control" id="floatingEmailInput"
                                        placeholder="name@example.com">
                                    <label for="floatingEmailInput" style="font-size: 0.75rem;">Địa chỉ email</label>
                                </div>
                                <div class="form-floating mb-3">
                                    <textarea class="form-control" placeholder="Leave a comment here"
                                        id="floatingContent" style="height: 100px"></textarea>
                                    <label for="floatingContent">Nội dung</label>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" value=""
                                        id="sendLastestMessageCheckbox">
                                    <label class="form-check-label" for="sendLastestMessageCheckbox">
                                        Gửi email thông báo cho tôi khi có phản hồi mới nhất
                                    </label>
                                </div>
                                <button id="contactButton" type="button" class="btn btn-success">Đăng bình luận</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- Chatbot Support -->


        <!-- Foreign tours swiper -->
        {{> footer}}
    </div>

    <!-- Page content -->
    <script>
        AOS.init();
    </script>
    <script src="https://www.gstatic.com/dialogflow-console/fast/messenger/bootstrap.js?v=1"></script>
    <df-messenger intent="WELCOME" chat-title="CHĂM SÓC KHÁCH HÀNG" agent-id="4d776812-d8f3-41db-8311-071ca02d6f36"
        language-code="en"></df-messenger>


    <script>
        function valueToVND(value) {
            const options = {
                style: 'currency',
                currency: 'VND',
                maximumFractionDigits: 9,
            }
            return new Intl.NumberFormat('vi-VN', options).format(value);
        }


    </script>


    <script>

        new Swiper(".swiper", {
            autoplay: {
                delay: 4000,
            },
            cssMode: true,
            loop: true,
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
            pagination: {
                el: ".swiper-pagination",
            },
        });

        new Swiper(".vietnam-tours-swiper", {
            autoplay: {
                delay: 5000,
            },
            cssMode: true,
            simulateTouch: false,
            loop: true,
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
            breakpoints: {
                576: {
                    slidesPerView: 1,
                },
                768: {
                    slidesPerView: 2,
                },
                992: {
                    slidesPerView: 4,
                },
            },
        });

        new Swiper(".foreign-tours-swiper", {
            autoplay: {
                delay: 5000,
            },
            cssMode: true,
            simulateTouch: false,
            loop: true,
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
            breakpoints: {
                576: {
                    slidesPerView: 1,
                },
                768: {
                    slidesPerView: 2,
                },
                992: {
                    slidesPerView: 4,
                },
            },
        });

    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const successMsg = "{{success_msg}}"
        const errorMsg = "{{error_msg}}"

        if (errorMsg) {
            Swal.fire({
                title: 'Thông báo',
                text: 'Vui lòng Đăng nhập để sử dụng dịch vụ!',
                icon: 'info',
                confirmButtonText: 'OK'
            })
        }
        if (successMsg) {
            Swal.fire({
                title: 'Chào mừng trở lại',
                text: 'Xin chào {{user.name}}',
                icon: 'success',
                confirmButtonText: 'OK'
            })
        }

    </script>


</body>

</html>