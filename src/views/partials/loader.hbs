<head>
    <style>
        .loader {
            border: 4px solid rgba(0, 0, 0, .1);
            border-left-color: transparent;
            border-radius: 50%;
            position: relative;
            top: 30vh;
            left: 50%;
        }

        .loader {
            border: 4px solid rgba(0, 0, 0, .1);
            border-left-color: transparent;
            width: 36px;
            height: 36px;
        }

        .loader {
            border: 4px solid rgba(0, 0, 0, .1);
            border-left-color: transparent;
            width: 36px;
            height: 36px;
            animation: spin89345 1s linear infinite;
        }

        @keyframes spin89345 {

            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);

            }
        }

        button {
            display: none;
        }
    </style>
</head>

<body>
    {{!-- <div id="loader" class="loader"></div>
    <a href="/login"> <button id="btn">Đăng nhập</button>
    </a> --}}

    <script src="src/public/js/sweetalert.min.js"></script>
    <script>
        // Đặt thời gian loader hiển thị
        setTimeout(() => {
            const loader = document.getElementById('loader');
            const btn = document.getElementById('btn');

            // Ẩn loader
            loader.style.opacity = '0';
            loader.style.transition = 'opacity 0.5s ease';

            // Sau khi chuyển đổi, ẩn hoàn toàn loader và hiển thị nội dung
            setTimeout(() => {
                loader.style.display = 'none';
                btn.style.display = 'block';
            }, 500); // Đợi 0.5s để animation hoàn thành
        }, 3000); // Thời gian loader hiển thị (3 giây)

        //dwads

    </script>
</body>