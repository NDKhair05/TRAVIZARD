<head>


    <link rel="stylesheet" href="/css/login.css" />


</head>

<body style="background-image: url('images/cau-rong-da-nang.jpg') ; background-repeat: no-repeat ">
    <div class="content">
        <form class="form" id="login-form">
            <p class="title">Đăng nhập </p>
            <p class="message">Chào mừng trở lại <img src="/images/logo-nonbackgr.png" alt="">
            </p>
            <div class="form-group">
                <label>
                    <input required="" placeholder="" type="text" class="input" name="loginName">
                    <span>Họ và tên</span>
                </label>
                <label>
                    <input required="" placeholder="" type="email" class="input" name="loginEmail">
                    <span>Email</span>
                </label>

                <label>
                    <input required="" placeholder="" type="password" class="input" name="loginPassword">
                    <span>Mật khẩu</span>
                </label>

            </div>
            <button class="submit" type="submit">Đăng nhập</button>
            <p class="signin">Chưa có tài khoản? <a href="/register">Đăng ký</a> </p>
        </form>
    </div>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputs = document.querySelectorAll('.input');

            inputs.forEach(input => {
                const span = input.nextElementSibling;

                // Lắng nghe sự kiện khi giá trị của input thay đổi
                input.addEventListener('input', function () {
                    if (this.checkValidity()) {
                        // Hợp lệ: Đổi màu span sang mặc định (hoặc xanh)
                        span.style.setProperty('color', 'green')
                        span.style.setProperty('top', '30px')
                        span.style.setProperty('font-size', '0.7em')
                        span.style.setProperty('font-weight', '600')

                    } else if (!this.checkValidity()) {
                        // Không hợp lệ: Đổi màu span sang đỏ
                        span.style.setProperty('color', 'red')
                        span.style.setProperty('top', '30px')
                        span.style.setProperty('font-size', '0.7em')
                        span.style.setProperty('font-weight', '600')
                    }
                });

                // Lắng nghe khi form được submit (nếu có)
                input.form?.addEventListener('submit', function (e) {
                    if (!input.checkValidity()) {
                        e.preventDefault(); // Ngăn gửi form nếu không hợp lệ
                        alert('Vui lòng nhập đúng định dạng!');
                    }
                });

            })
        });

        document.getElementById('login-form').addEventListener('submit', async (e) => {
            e.preventDefault();

            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data),
                });

                const result = await response.json();

                if (result.status === 'success') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: result.message,
                    }).then(() => {
                        window.location.href = '/';
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thất bại',
                        text: result.message,
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Đã xảy ra lỗi trong quá trình xử lý',
                });
            }
        });


    </script>

</body>