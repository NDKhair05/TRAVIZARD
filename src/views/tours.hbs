<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="css/search-bar.css">
    <link rel="stylesheet" href="css/tour.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/material_blue.css">


</head>

<body>
    <!-- Page content -->
    <div class="container-fill">
        <div class="searching-container" style="background-image: url('images/anh-background-tim-kiem.jpg');">
            <div class="searching-form">
                <form id="search-form">

                    <div class="destination-div">
                        <i class="fa-solid fa-location-dot"></i>
                        <input class="destination" id="destination" type="text" placeholder="Bạn muốn đi đâu?">
                    </div>

                    <div class="datepicker-div">
                        <i class="fa-solid fa-calendar"></i>
                        <input id="datepicker" placeholder="Ngày khởi hành">
                    </div>

                    <div class="departure-div">
                        <i class="fa-solid fa-plane-departure"></i>
                        <select id="departure" name="departure">
                            <option value="TP Hồ Chí Minh">TP Hồ Chí Minh</option>
                            <option value="Đà Nẵng">Đà Nẵng</option>
                            <option value="Hà Nội">Hà Nội</option>
                        </select>
                    </div>
                    <button id="search" type="submit"><b>Tìm</b></button>
                </form>
            </div>
        </div>

        <div class="row p-3 mt-2 tour-types d-flex justify-content-center" data-aos="fade-right">
            <div class="col-lg-4 d-flex justify-content-center align-items-center tour-type m-2 p-4">

                <a class="tours-heading-link" href="vietnamTours.html"><i class="fa-solid fa-glasses fa-xl mx-2"></i>DU
                    LỊCH
                    TRONG NƯỚC</a>
            </div>
            <div class="col-lg-4 d-flex justify-content-center align-items-center tour-type m-2 p-4">

                <a class="tours-heading-link" href="foreignTours.html"><i
                        class="fa-solid fa-wine-glass fa-xl mx-2"></i>DU LỊCH
                    NƯỚC NGOÀI</a>
            </div>
            <div class="col-lg-4 d-flex justify-content-center align-items-center tour-type m-2 p-4">

                <a class="tours-heading-link" href="introduction.html"><i class="fa-solid fa-home fa-xl mx-2"></i>GIỚI
                    THIỆU</a>
            </div>
            <div class="col-lg-4 d-flex justify-content-center align-items-center tour-type m-2 p-4">
                <a class="tours-heading-link" href="hotels.html"><i class="fa-solid fa fa-hotel fa-xl mx-2"></i>CHO THUÊ
                    KHÁCH
                    SẠN</a>
            </div>
        </div>
        <div>
            <div class="d-flex justify-content-between align-items-center mx-5 mt-5 mb-3">
                <a class="tours-heading-link" style="text-decoration: none;">DANH SÁCH TOUR</a>
            </div>
            <div class="px-5">
                <div class="row" id="tour-container">
                    {{#each tours}}
                    <div class="card">
                        <div class="hovereffect">
                            <img class="card-img-top" src="{{this.tour_img}}" alt="">
                            <div class="overlay">
                                <h2>{{this.departure}}</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Tour information -->
                            <div class="d-flex flex-column justify-content-start">
                                <a class="text-start mb-3 tour-title" style="text-decoration: none; font-size: 20px;"
                                    href="/tours/{{this.tour_id}}">{{this.tour_name}}</a>
                                <div class="d-flex align-items-center">
                                    <i class="fa-regular fa-clock mx-2"></i>
                                    <a style="font-size: 0.85rem" style="font-size: 18px;">{{this.duration}}</a>
                                </div>
                                <div class="d-flex align-items-center mt-1">
                                    <i class="fa-regular fa-calendar mx-2"></i>
                                    <a style="font-size: 0.85rem" style="font-size: 18px;">{{this.dep_date}}</a>
                                </div>
                                <div class="d-flex align-items-center mt-1">
                                    <i class="fa-regular fa-user mx-2"></i>
                                    <a style="font-size: 0.85rem" style="font-size: 18px;">{{this.slot}}</a>
                                </div>
                                <div class="d-flex align-items-center mt-1">
                                    <i class="fa-solid fa-sack-dollar mx-2"></i>
                                    <a class="text-decoration-none" style="color: red; font-weight: bold;"
                                        id="tourPrice" style="font-size: 18px;">{{formatPrice this.price}}</a>
                                </div>
                            </div>
                            <!-- Tour information -->
                        </div>
                    </div>
                    {{/each}}

                </div>
            </div>
        </div>



        <script src="https://www.gstatic.com/dialogflow-console/fast/messenger/bootstrap.js?v=1"></script>
        <df-messenger intent="WELCOME" chat-title="CHĂM SÓC KHÁCH HÀNG" agent-id="4d776812-d8f3-41db-8311-071ca02d6f36"
            language-code="en"></df-messenger>






        <!-- Foreign tours swiper -->
        {{>footer}}

    </div>
    <!-- Page content -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/flatpickr.min.js"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script>
        flatpickr("#datepicker", {
            dateFormat: "l, j-m-Y",
            minDate: "today",
        });

    </script>

    <script>
        AOS.init();

        const searchForm = document.getElementById('search-form');
        const resultsDiv = document.getElementById('tour-container');

        searchForm.addEventListener('submit', async function (event) {
            event.preventDefault();

            const destination = document.getElementById('destination').value.trim();
            const travel_date = document.getElementById('datepicker').value.trim().split(', ')[1]; // Lấy ngày sau dấu phẩy
            const departure = document.getElementById('departure').value;

            try {
                const response = await fetch('/search-tour', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ destination, travel_date, departure }),
                });

                if (!response.ok) {
                    const errorData = await response.json(); // Lấy thông tin lỗi từ server (nếu có)
                    throw new Error(errorData.error || `HTTP error! status: ${response.status}`);
                }

                const results = await response.json();

                resultsDiv.innerHTML = ''; // Xóa kết quả cũ trước khi hiển thị kết quả mới

                if (results.length > 0) {
                    const tourCards = results.map(tour => `
                                    <div class="card">
                        <div class="hovereffect">
                            <img class="card-img-top" src=" ${tour.tour_img}" alt="">
                            <div class="overlay">
                                <h2> ${tour.departure}</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Tour information -->
                            <div class="d-flex flex-column justify-content-start">
                                <a class="text-start mb-3 tour-title" style="text-decoration: none; font-size: 20px;"
                                    href="/tours/ ${tour.tour_id}"> ${tour.tour_name}</a>
                                <div class="d-flex align-items-center">
                                    <i class="fa-regular fa-clock mx-2"></i>
                                    <a style="font-size: 0.85rem" style="font-size: 18px;"> ${tour.duration}</a>
                                </div>
                                <div class="d-flex align-items-center mt-1">
                                    <i class="fa-regular fa-calendar mx-2"></i>
                                    <a style="font-size: 0.85rem" style="font-size: 18px;"> ${tour.dep_date}</a>
                                </div>
                                <div class="d-flex align-items-center mt-1">
                                    <i class="fa-regular fa-user mx-2"></i>
                                    <a style="font-size: 0.85rem" style="font-size: 18px;"> ${tour.slot}</a>
                                </div>
                                <div class="d-flex align-items-center mt-1">
                                    <i class="fa-solid fa-sack-dollar mx-2"></i>
                                    <a class="text-decoration-none" style="color: red; font-weight: bold;"
                                        id="tourPrice" style="font-size: 18px;">${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(tour.price)}</a>
                                </div>
                            </div>
                            <!-- Tour information -->
                        </div>
                    </div>


                `).join(''); // Tạo chuỗi HTML từ mảng các tour card
                    resultsDiv.innerHTML = tourCards;
                } else {
                    resultsDiv.innerHTML = '<p>Không tìm thấy tour nào phù hợp!</p>';
                }
            } catch (error) {
                console.error("Lỗi khi tìm kiếm tour:", error);
                resultsDiv.innerHTML = '<p>Đã có lỗi xảy ra trong quá trình tìm kiếm. Vui lòng thử lại sau.</p>';
            }
        });
    </script>
</body>

</html>